[Unit]
Description=Yihone Portfolio Chat Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/yichu10c.github.io/kb
ExecStart=/home/ubuntu/.hermes/.venv/bin/python3 chat_server.py
Restart=always
EnvironmentFile=/home/ubuntu/.hermes/.env

[Install]
WantedBy=multi-user.target
